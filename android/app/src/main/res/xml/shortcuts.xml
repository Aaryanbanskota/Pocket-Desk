<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="shortcut_widgets"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_widget"
        android:shortcutShortLabel="@string/shortcut_widgets"
        android:shortcutLongLabel="@string/shortcut_widgets_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pocketdesk.pocketdesk"
            android:targetClass="com.pocketdesk.pocketdesk.MainActivity">
            <extra android:name="action" android:value="open_widgets" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_new_task"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_task"
        android:shortcutShortLabel="@string/shortcut_new_task"
        android:shortcutLongLabel="@string/shortcut_new_task">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pocketdesk.pocketdesk"
            android:targetClass="com.pocketdesk.pocketdesk.MainActivity">
            <extra android:name="action" android:value="add_task" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="shortcut_new_note"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_note"
        android:shortcutShortLabel="@string/shortcut_new_note"
        android:shortcutLongLabel="@string/shortcut_new_note">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.pocketdesk.pocketdesk"
            android:targetClass="com.pocketdesk.pocketdesk.MainActivity">
            <extra android:name="action" android:value="add_note" />
        </intent>
    </shortcut>
</shortcuts>
