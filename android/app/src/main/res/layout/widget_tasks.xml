<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_tasks_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Bar: Title, Count Badge, Add Button -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/btn_tasks_add"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tasks"
                android:textColor="@color/widget_accent_orange"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_tasks_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/widget_button_bg"
                android:paddingStart="6dp"
                android:paddingTop="1dp"
                android:paddingEnd="6dp"
                android:paddingBottom="1dp"
                android:text="3 left"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btn_tasks_add"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/widget_action_circle"
            android:contentDescription="Add Task"
            android:padding="5dp"
            android:src="@drawable/ic_widget_add" />
    </RelativeLayout>

    <!-- Subtle Divider -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="6dp"
        android:background="@color/widget_divider" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layout_tasks_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_tasks_empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="All caught up! 🎉"
            android:textColor="@color/widget_text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_tasks_empty_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Tap + to add a task"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10.5sp" />
    </LinearLayout>

    <!-- Tasks List Container -->
    <LinearLayout
        android:id="@+id/layout_tasks_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Task Row 1 -->
        <LinearLayout
            android:id="@+id/task_row_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_task_1_check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Check"
                android:src="@drawable/ic_widget_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_task_1_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="First Task"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_task_1_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Today"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Task Row 2 -->
        <LinearLayout
            android:id="@+id/task_row_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_task_2_check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Check"
                android:src="@drawable/ic_widget_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_task_2_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Second Task"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_task_2_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Today"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Task Row 3 -->
        <LinearLayout
            android:id="@+id/task_row_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_task_3_check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Check"
                android:src="@drawable/ic_widget_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_task_3_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Third Task"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_task_3_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Today"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Task Row 4 -->
        <LinearLayout
            android:id="@+id/task_row_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_task_4_check"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="Check"
                android:src="@drawable/ic_widget_circle" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_task_4_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Fourth Task"
                    android:textColor="@color/widget_text_primary"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_task_4_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Today"
                    android:textColor="@color/widget_text_secondary"
                    android:textSize="9.5sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Footer -->
    <TextView
        android:id="@+id/tv_tasks_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Open MyDay Tasks →"
        android:textColor="@color/widget_accent_orange"
        android:textSize="10sp"
        android:textStyle="bold" />
</LinearLayout>
