<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_actions_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- App Brand & Title -->
    <LinearLayout
        android:id="@+id/btn_open_app"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MyDay"
            android:textColor="@color/widget_accent_orange"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Quick Capture"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action: Add Task -->
    <ImageView
        android:id="@+id/btn_widget_add_task"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_action_circle"
        android:contentDescription="Add Task"
        android:padding="9dp"
        android:src="@drawable/ic_widget_add" />

    <!-- Action: Add Note -->
    <ImageView
        android:id="@+id/btn_widget_add_note"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_action_circle"
        android:contentDescription="Add Note"
        android:padding="9dp"
        android:src="@drawable/ic_widget_note" />

    <!-- Action: Calendar Agenda -->
    <ImageView
        android:id="@+id/btn_widget_calendar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/widget_action_circle"
        android:contentDescription="Calendar"
        android:padding="9dp"
        android:src="@drawable/ic_widget_calendar" />

    <!-- Action: Open Widgets -->
    <ImageView
        android:id="@+id/btn_widget_gallery"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_action_circle"
        android:contentDescription="Widgets"
        android:padding="9dp"
        android:src="@drawable/ic_shortcut_widget" />
</LinearLayout>
